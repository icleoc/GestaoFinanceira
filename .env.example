# Copie este arquivo para .env.local (uso local) ou cadastre as mesmas
# variáveis em Vercel > Project > Settings > Environment Variables.

# --- Públicas (podem ir para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable

# --- SECRETAS (só no servidor; cadastre no Vercel, nunca em arquivo do repositório) ---
# Chave "secret" / service_role do Supabase. Usada só pelas rotas /api/equipe e /api/provisionar
# para criar usuários. Ela ignora toda a segurança do banco.
SUPABASE_SERVICE_ROLE_KEY=
# Senha de integração com o sistema de vendas (24+ caracteres aleatórios).
# Quem souber esse valor consegue criar clientes novos em /api/provisionar.
PROVISION_SECRET=

# Leitura automática da foto da nota (empresa, itens, valor e categoria).
# Opção GRATUITA: chave do Gemini em https://aistudio.google.com/apikey (tem prioridade se existir).
# Na camada gratuita, o Google pode usar o conteúdo enviado para melhorar os produtos dele.
GEMINI_API_KEY=
# GEMINI_MODEL=
# Opção paga por uso: chave da Anthropic em console.anthropic.com (usada se não houver GEMINI_API_KEY).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
